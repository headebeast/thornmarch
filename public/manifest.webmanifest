{
  "id": "/",
  "name": "Thornmarch Tactics",
  "short_name": "Thornmarch",
  "description": "Classic turn-based tactics, rebuilt for every screen — campaign, skirmish, the Frontier realm and a 60-warband Battle Royale.",
  "lang": "en",
