    { "name": "Frontier", "short_name": "Frontier", "description": "A vast realm to farm, scout and conquer", "url": "/?play=frontier&source=shortcut", "icons": [{ "src": "/assets/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }] },
