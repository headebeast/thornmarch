  ],
  "screenshots": [
    { "src": "/assets/screenshots/menu-wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Campaign, Skirmish, the Frontier realm and Battle Royale from one menu" },
    { "src": "/assets/screenshots/royale-wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Battle Royale: plan your warband's moves, claim camps and mines, recruit with gold" }
  ],
  "shortcuts": [
